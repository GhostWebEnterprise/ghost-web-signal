<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/ghostweb_signal_panel_2"
                android:centerColor="@color/ghostweb_signal_panel"
                android:endColor="@color/ghostweb_signal_bg" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/ghostweb_signal_line" />
        </shape>
    </item>
    <item android:top="96dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@android:color/transparent"
                android:centerColor="@color/ghostweb_signal_cyan"
                android:endColor="@android:color/transparent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
